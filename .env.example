# Set the key only in your ignored local .env, never here or in chat.
# Application commands load .env automatically; process variables take precedence.
GARMIN_PERSONAL_API_KEY=

# Defaults below; keep storage outside the checkout and restrict its permissions.
# STRIDELOG_DATA_DIR=~/.stridelog
# STRIDELOG_ACTIVITY_LOOKBACK_DAYS=7
# STRIDELOG_WELLNESS_LOOKBACK_DAYS=3
# Minimum one second; NaN/infinity and negative lookbacks are rejected.
# STRIDELOG_REQUEST_INTERVAL_S=1.0
# JSON array of taxonomy keys; descendants from the returned catalog also count.
# STRIDELOG_RUNNING_ACTIVITY_TYPES=["running","trail_running","treadmill_running","track_running"]
# Actual key expiration date from Garmin, not its creation date.
# STRIDELOG_API_KEY_EXPIRES_ON=YYYY-MM-DD

# Inclusive activity-local date; fallback only when HR exists and FIT cannot
# establish the source. Label as user-assumed, not sensor-confirmed (Phase 3).
# STRIDELOG_HR_ARMBAND_FROM=YYYY-MM-DD
