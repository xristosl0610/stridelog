# Set the key only in your ignored local .env, never here or in chat.
# Phase 1 discovery loads it explicitly with uv run --env-file .env.
GARMIN_PERSONAL_API_KEY=

# Planned application settings; configuration loading arrives in Phase 2.
# STRIDELOG_DATA_DIR
# STRIDELOG_ACTIVITY_LOOKBACK_DAYS
# STRIDELOG_WELLNESS_LOOKBACK_DAYS
# STRIDELOG_REQUEST_INTERVAL_S
# Actual key expiration date from Garmin, not its creation date (Phase 2).
# STRIDELOG_API_KEY_EXPIRES_ON=YYYY-MM-DD

# Inclusive activity-local date; fallback only when HR exists and FIT cannot
# establish the source. Label as user-assumed, not sensor-confirmed (Phase 3).
# STRIDELOG_HR_ARMBAND_FROM=YYYY-MM-DD
